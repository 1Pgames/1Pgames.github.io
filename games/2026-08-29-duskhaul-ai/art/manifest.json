  "qcExceptions": [
    {
      "id": "zone-*/floor-*",
      "reason": "Full-bleed seamless floor tiles deliberately touch every canvas edge; strict background QC cannot pass by design (documented strict:false exception, same class as template arena/floor)."
    },
    {
      "id": "zone-*/border-*",
      "reason": "Tileable border bands touch the canvas edge on purpose; strict:false by design."
    },
    {
      "id": "ui-icons/bg-menu",
      "reason": "Full-bleed 9:16 backdrop; strict:false by design (template bg/arena precedent)."
    },
    {
      "id": "elites-warden/boss-warden-idle-*",
      "reason": "Zone skins ship as fully generated idle sheets (shoulder/crown silhouette swap per PRD §11); sweep/summon/enrage/death sheets are shared from the castle base — at boss render size skin identity reads from idle/crown, and 4x5 fully-skinned action sets would spend ~17 extra generations on frames visible <10s per run."
    },
    {
      "id": "zone-winter/floor-winter",
      "reason": "Palette meanDistance 44.48 (inside the profile's 48 cap, but over the zone brief's stricter 36): style.json's 18-colour list contains NO cold blue, so a correct Widow's Crown snowfield cannot score near 36. This REPLACES the previous tile, which scored 48.46 — actually over the cap — because it had been compromised toward the plum-grey palette until it read as grey slate rock rather than snow, which is the defect the pre-handoff critic flagged. Regenerated to hold the zone's cold-blue snow identity; the gate, not the tile, is what cannot be satisfied here."
    },
    {
      "id": "zone-desert/floor-desert",
      "reason": "art_review value-tier-absent:dark (0.4% dark against a planned 60%). This is the DESERT MIRROR RISK the zone brief names explicitly: the zone inverts figure/ground on purpose — a light bone field so the dark actors read as holes in the sand — so style.json's actor-authored 60/32/8 valuePlan cannot apply to this tile. Verified non-discriminating for floors: the same art_review call fails value-tier-absent:light on the castle and outlands floors, the two tiles the critic judged excellent, and reports silhouette distance 0.000 between all four because a full-bleed tile's occupancy is identically 1.0. Hard gates all pass: minAlpha 255, no black mass (0.01% under luma 60, all of it the style's own 1px bone-chip outlines), palette meanDistance 29.55, and actor figure/ground clash 0.63% against the old tile's 27.45%. Residual weakness kept knowingly: the violet trough mid tier reads thinner than the briefed one third (mid 5.6%)."
    }
  ],
  "integration": {
    "note": "scripts/gen-art-registry.mjs is the only writer of src/data/art.ts. Integrator must add groups hero, enemies-light, enemies-heavy, elites-warden, pickups-fx, gates-collapse, zone-castle, zone-outlands, zone-desert, zone-winter, ui-icons to the arena slice's ART_GROUPS.",
    "registry": "node scripts/gen-art-registry.mjs"
  }
