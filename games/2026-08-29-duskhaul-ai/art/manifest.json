{
  "styleProfile": "art/style.json",
  "outputRoot": "public/assets/generated",
  "conventions": {
    "bodyCellSize": 256,
    "fxCellSize": 128,
    "uiCellSize": 256,
    "bodyProfile": "pixel-art-body",
    "fxProfile": "pixel-art-fx",
    "canvas": {
      "image_size": "1024x1024",
      "aspect_ratio": "1:1"
    },
    "visionAnchors": [
      "games/2026-08-29-duskhaul/art/refs/vision-1.png",
      "games/2026-08-29-duskhaul/art/refs/vision-2.png"
    ],
    "note": "Gritty-pixel set: pixel-art-* profiles (nearest sampling, hard magenta key). Non-NxN grids (1x2, 2x3, 2x4) have non-square source cells: never lock them to a scale profile - hold consistency with maxBodyScaleCv 0.08 / maxAnchorYStd 0.05 plus an anchor guide. Exported sheets normalise to square cellSize frames regardless. Generation briefs live in art/briefs/<group>.md."
  },
  "assetSchema": {
    "groupNote": "Each `groups[]` entry's `group` name is both the directory under outputRoot and the registry row group. PreloadScene loads a row only when its group is in the arena slice's ART_GROUPS (integrator's edit). A missing asset inside a present group is a hard error.",
    "id": "Directory name under outputRoot/<group>/<id>/. Also the default texture/animation key.",
    "kind": "'body' | 'fx' | 'ui' | 'bg' - documentation only.",
    "facesRight": "Optional, default true.",
    "baseAction": "Optional, true on exactly one asset of a multi-action single-character group.",
    "loop": "Optional, default true.",
    "duration": "Optional ms-per-frame override. 0 = sheet addressed by frame index, no animation.",
    "textureAlias": "Optional TEXTURE.<alias> constant.",
    "animAlias": "Optional ANIM.<alias> constant.",
    "icons": "Optional string[] on an icon/prop sheet; index = frame number, each name adds ICON.<name>."
  },
